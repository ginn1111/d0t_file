/**
 * Cindy Warm Dusk
 * Source palette: ~/tools/agent-d0tfile/themes/cindy/warm-dusk.palette
 * Rule: ruby = focus/accent only; errors/urgent use err.
 **/

* {
    background:     #1d1a17FF;   /* bg      */
    background-alt: #2a2520FF;   /* surface */
    foreground:     #d6cbb8FF;   /* fg      */
    selected:       #d9a05bFF;   /* accent (ruby) */
    active:         #b3a894FF;   /* sub     */
    urgent:         #cf6b6bFF;   /* err     */
}
