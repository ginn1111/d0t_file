/**
 * Cindy Black & Ruby
 * Source palette: ~/tools/agent-d0tfile/themes/cindy/black-ruby.palette
 * Rule: ruby = focus/accent only; errors/urgent use err.
 **/

* {
    background:     #111418FF;   /* bg      */
    background-alt: #1c2027FF;   /* surface */
    foreground:     #bec6d0FF;   /* fg      */
    selected:       #c62f52FF;   /* accent (ruby) */
    active:         #a0acbbFF;   /* sub     */
    urgent:         #e35535FF;   /* err     */
}
