# i3 config file (v4)
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

# Set mod key (Mod1=<Alt>, Mod4=<Super>)
set $mod Mod4
#enable xborder

# swap escape and capslock
exec_always --no-startup-id setxkbmap -option caps:swapescape

exec_always --no-startup-id picom

# Cursor: Bibata-Original-Ice, size 24 (user-local theme in ~/.local/share/icons).
# xrdb loads Xcursor.* from ~/.Xresources; xsetroot applies it to the root window
# so the desktop background doesn't fall back to the X "X" cursor.
exec_always --no-startup-id sh -c 'xrdb -merge ~/.Xresources; XCURSOR_THEME=Bibata-Original-Ice XCURSOR_SIZE=24 xsetroot -cursor_name left_ptr'
# Notifications: dunst (config ~/.config/dunst/dunstrc). Evict GNOME's notifier first.
exec --no-startup-id sh -c 'pkill -f org.gnome.Shell.Notifications; exec dunst'

# xborders: slight rounding (6px, matches picom corner-radius). Cindy honey accent (#d9a05b) at ~90% opacity
# pkill first: exec_always re-runs on every reload and would stack overlays.
exec_always --no-startup-id sh -c 'pkill -f "[p]ython3 .*/xborders"; sleep 0.5; exec env GDK_BACKEND=x11 ~/.local/bin/xborders \
  --border-radius 6 \
  --border-width 2 \
  --border-mode inside \
  --border-rgba "#d9a05be6"'

# setup monitors
exec_always xrandr \
  --output DP-2 --primary --mode 1920x1080 --rate 100 \
  --output HDMI-1 --mode 1920x1080 --rate 100 --right-of DP-2


exec_always --no-startup-id ~/.config/polybar/launch.sh

#workspace 2 output LVDS-1
#workspace 1 output VGA-1

# set default desktop layout (default is tiling)
# workspace_layout tabbed <stacking|tabbed>

# Configure border style <normal|1pixel|pixel xx|none|pixel>
default_border none 
default_floating_border none

# Hide borders
hide_edge_borders none

# change borders
bindsym $mod+u border none
bindsym $mod+y border pixel 1
bindsym $mod+n border normal
bindsym $mod+Shift+s exec flameshot gui
bindsym $mod+ctrl+l exec --no-startup-id i3lock -c 000000 #-i ~/.config/i3/wallpaper.png
bindsym $mod+Ctrl+greater move workspace to output right
bindsym $mod+Ctrl+less move workspace to output left

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Terminess Nerd Font 10

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec kitty

# kill focused window
bindsym $mod+Shift+q kill

# start program launcher
#bindsym $mod+d exec --no-startup-id dmenu_recency
bindsym $mod+d exec --no-startup-id  ~/.config/rofi/launchers/type-4/launcher.sh

# launch categorized menu
bindsym $mod+z exec --no-startup-id morc_menu

